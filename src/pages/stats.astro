---
import Base from "../layouts/Base.astro";
import Card from "../components/aperture/Card.astro";
import StatTile from "../components/aperture/StatTile.astro";
import BarList from "../components/aperture/BarList.astro";
import Legend from "../components/aperture/Legend.astro";
import LineChart from "../components/aperture/LineChart.astro";
import ColumnChart from "../components/aperture/ColumnChart.astro";
import { getCollection, getStats, getWantlist } from "../lib/view-model.ts";
import { formatDate, formatMoney } from "../lib/format.ts";

const stats = getStats();
const artists = new Set(getCollection().map((i) => i.artists)).size;
const wantCount = getWantlist().length;

// Year 0 is how Discogs marks an unknown release year.
const decades = [
  ...stats.decades.filter((d) => d.decade !== "0s").map((d) => ({ label: d.decade, short: `’${d.decade.slice(2)}`, value: d.count })),
  ...stats.decades.filter((d) => d.decade === "0s").map((d) => ({ label: "Unknown", short: "?", value: d.count })),
];

const history = stats.valueHistory.map((v) => ({ date: v.date, value: v.total }));
const latest = history.at(-1);
const previous = history.at(-2);
const change = latest && previous ? latest.value - previous.value : undefined;
---

<Base title="Stats" nav="stats">
	{latest && <span slot="actions" class="t-small muted">Values as of {formatDate(latest.date)}</span>}

	{
		stats.totalRecords === 0 ? (
			<p class="empty">Stats for your records will appear here after the first sync.</p>
		) : (
			<div class="stack">
				<div class="tiles">
					<StatTile label="Records" value={stats.totalRecords.toLocaleString("en-US")} />
					<StatTile label="Artists" value={artists.toLocaleString("en-US")} />
					<StatTile
						label="Collection value"
						value={latest ? formatMoney(latest.value) : "—"}
						delta={change ? formatMoney(Math.abs(change)) : undefined}
						direction={change ? (change > 0 ? "up" : "down") : undefined}
						tone={change ? (change > 0 ? "gain" : "loss") : "neutral"}
						data={history.map((h) => h.value)}
					/>
					<StatTile label="Wantlist" value={wantCount.toLocaleString("en-US")} />
				</div>

				<Card title="Collection value over time">
					{history.length === 0 ? (
						<p class="empty">
							Weekly valuations will appear here. Run <code>npm run valuations</code> each week and this fills in over time.
						</p>
					) : (
						<div class="chart-block">
							<Legend items={[{ label: "Sum of lowest listed prices", value: latest ? formatMoney(latest.value) : undefined }]} />
							<LineChart points={history} label="Collection value over time" />
						</div>
					)}
				</Card>

				<Card title="Records by decade">
					<ColumnChart columns={decades} label="Records by decade" />
				</Card>

				<div class="pair">
					<Card title="Top genres">
						<BarList rows={stats.genres.map((g) => ({ label: g.name, value: g.count }))} noun="genre" />
					</Card>
					<Card title="Top labels">
						<BarList rows={stats.labels.map((l) => ({ label: l.name, value: l.count }))} noun="label" />
					</Card>
				</div>

				<p class="t-caption muted footnote">
					Collection value is the sum of the lowest current Discogs listing for each record that has one.
					Genre and label counts can exceed the record count because a release can carry several.
				</p>
			</div>
		)
	}
</Base>

<style>
	.stack {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.tiles {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: var(--space-3);
	}

	@media (max-width: 1099px) {
		.tiles {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 479px) {
		.tiles {
			grid-template-columns: 1fr;
		}
	}

	.chart-block {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.pair {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-3);
	}

	@media (max-width: 899px) {
		.pair {
			grid-template-columns: 1fr;
		}
	}

	.footnote {
		margin: var(--space-2) 0 0;
	}
</style>
