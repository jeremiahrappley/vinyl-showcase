---
import Base from "../../layouts/Base.astro";
import Cover from "../../components/Cover.astro";
import Card from "../../components/aperture/Card.astro";
import Icon from "../../components/aperture/Icon.astro";
import { getAllInstanceIds, getInstanceDetail } from "../../lib/view-model.ts";
import { formatDate, formatMoney, plural } from "../../lib/format.ts";

export function getStaticPaths() {
  return getAllInstanceIds().map((instanceId) => ({ params: { instance: String(instanceId) } }));
}

const { instance } = Astro.params;
const item = getInstanceDetail(Number(instance));
if (!item) throw new Error(`No instance found for ${instance}`);

const released =
  item.released && /^\d{4}-\d{2}-\d{2}$/.test(item.released) && !item.released.endsWith("-00")
    ? formatDate(item.released)
    : item.released;
const releasedNote = released && released !== String(item.year) ? ` (${released})` : "";
const byline = item.year ? `${item.artists} · ${item.year}${releasedNote}` : item.artists;
const valuation = item.latestValuation;

const facts: { term: string; detail: string }[] = [
  { term: "Format", detail: item.formats.join(", ") },
  { term: "Label", detail: item.labels.map((l) => `${l.name} (${l.catno})`).join(", ") },
  ...(item.country ? [{ term: "Country", detail: item.country }] : []),
  ...(item.genres.length > 0 ? [{ term: "Genre", detail: item.genres.join(", ") }] : []),
  ...(item.styles.length > 0 ? [{ term: "Style", detail: item.styles.join(", ") }] : []),
  { term: "Added", detail: formatDate(item.dateAdded) },
];
---

<Base title={item.title} nav="collection" parents={[{ label: "Collection", href: "/" }]}>
	<a slot="actions" class="ap-btn ap-btn--sm" href={item.discogsUrl} target="_blank" rel="noopener">
		<Icon name="external-link" />
		View on Discogs
	</a>

	<div class="record">
		<div class="record-cover">
			<Cover cover={item.cover} size="hero" alt={item.title} eager />
		</div>

		<div class="record-info">
			<p class="byline t-section-title">{byline}</p>

			<Card title="Details">
				<dl class="facts">
					{
						facts.map((f) => (
							<div>
								<dt>{f.term}</dt>
								<dd>{f.detail}</dd>
							</div>
						))
					}
				</dl>
			</Card>

			{
				valuation && (
					<Card title="Lowest for sale">
						<p class="price">
							{valuation.lowestPrice != null ? formatMoney(valuation.lowestPrice, valuation.currency) : "—"}
						</p>
						<p class="t-small muted price-note">
							{plural(valuation.numForSale, "listing")} on Discogs, as of {formatDate(valuation.date)}
						</p>
					</Card>
				)
			}
		</div>
	</div>

	{
		item.tracklist.length > 0 && (
			<Card title="Tracklist" flush class="section">
				<div class="ap-table-wrap">
					<table class="ap-table">
						<thead>
							<tr>
								<th scope="col">Position</th>
								<th scope="col">Title</th>
								<th scope="col" class="is-num">Duration</th>
							</tr>
						</thead>
						<tbody>
							{item.tracklist.map((t) => (
								<tr>
									<td class="muted">{t.position}</td>
									<td class="track-title">{t.title}</td>
									<td class="is-num muted">{t.duration || "—"}</td>
								</tr>
							))}
						</tbody>
					</table>
				</div>
			</Card>
		)
	}

	{
		item.credits.length > 0 && (
			<Card title="Credits" class="section">
				<p class="prose">{item.credits.map((c) => `${c.name} (${c.role})`).join(" · ")}</p>
			</Card>
		)
	}

	{
		item.notes && (
			<Card title="Notes" class="section">
				<p class="prose notes">{item.notes}</p>
			</Card>
		)
	}
</Base>

<style>
	.record {
		display: grid;
		grid-template-columns: minmax(240px, 380px) minmax(0, 1fr);
		gap: var(--space-6);
		margin-bottom: var(--space-3);
	}

	@media (max-width: 899px) {
		.record {
			grid-template-columns: minmax(0, 1fr);
		}

		.record-cover {
			max-width: 380px;
		}
	}

	.record-cover {
		align-self: start;
	}

	.record-info {
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
		min-width: 0;
	}

	.byline {
		margin: 0 0 var(--space-1);
		color: var(--text-muted);
	}

	.facts {
		display: grid;
		gap: var(--space-3);
		margin: 0;
	}

	.facts > div {
		display: grid;
		grid-template-columns: 96px minmax(0, 1fr);
		gap: var(--space-3);
	}

	.facts dt {
		color: var(--text-muted);
	}

	.facts dd {
		margin: 0;
	}

	.price {
		margin: 0;
		font: 600 28px/32px var(--font-sans);
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.01em;
	}

	.price-note {
		margin: var(--space-1) 0 0;
	}

	.section {
		margin-top: var(--space-3);
	}

	.track-title {
		width: 100%;
	}

	.prose {
		margin: 0;
		color: var(--text-muted);
		max-width: 72ch;
	}

	.notes {
		white-space: pre-line;
	}
</style>
