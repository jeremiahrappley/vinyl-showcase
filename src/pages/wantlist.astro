---
import Base from "../layouts/Base.astro";
import RecordGrid from "../components/RecordGrid.astro";
import { getWantlist } from "../lib/view-model.ts";
import { plural } from "../lib/format.ts";

const wants = getWantlist();
---

<Base title="Wantlist" nav="wantlist">
	<span slot="actions" class="t-small muted">{plural(wants.length, "record")}</span>

	{
		wants.length === 0 ? (
			<p class="empty">Records on the Discogs wantlist will appear here after the next sync.</p>
		) : (
			<RecordGrid
				records={wants.map((w) => ({
					key: w.releaseId,
					href: w.discogsUrl,
					external: true,
					cover: w.cover,
					title: w.title,
					artists: w.artists,
					year: w.year,
				}))}
			/>
		)
	}
</Base>
