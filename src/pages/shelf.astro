---
import Base from "../layouts/Base.astro";
import Card from "../components/aperture/Card.astro";
import { getCollection } from "../lib/view-model.ts";
import { plural, readableOn } from "../lib/format.ts";

const items = getCollection();
const byArtist = [...items].sort((a, b) => a.artists.localeCompare(b.artists) || a.year - b.year);
---

<Base title="Shelf" nav="shelf">
	<span slot="actions" class="t-small muted">{plural(items.length, "record")}</span>

	{
		byArtist.length === 0 ? (
			<p class="empty">Records you sync will appear here as spines, sorted by artist.</p>
		) : (
			<Card title="Sorted by artist">
				<div class="shelf">
					{byArtist.map((item) => {
						const spine = item.cover?.palette[0];
						const style = spine ? `background:${spine};color:${readableOn(spine)};` : "";
						const label = item.year ? `${item.artists} — ${item.title} (${item.year})` : `${item.artists} — ${item.title}`;
						return (
							<a class="spine" href={`/r/${item.instanceId}/`} style={style} title={label} aria-label={label}>
								<span>
									{item.artists} — {item.title}
								</span>
							</a>
						);
					})}
				</div>
			</Card>
		)
	}
</Base>

<style>
	.shelf {
		display: flex;
		flex-wrap: wrap;
		align-items: stretch;
		gap: 2px;
		row-gap: var(--space-4);
	}

	.spine {
		width: 28px;
		height: 240px;
		flex-shrink: 0;
		text-decoration: none;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		padding: var(--space-2) 0;
		background: var(--surface-active);
		color: var(--text);
		border-radius: var(--radius-sm);
		transition: opacity 120ms linear;
	}

	/* Quietly dim the other spines so the hovered one reads as selected. */
	.shelf:hover .spine:not(:hover),
	.shelf:focus-within .spine:not(:focus-visible) {
		opacity: 0.55;
	}

	.spine span {
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		max-height: 100%;
		font: 500 12px/16px var(--font-sans);
	}

	@media (prefers-reduced-motion: reduce) {
		.spine {
			transition: none;
		}
	}
</style>
