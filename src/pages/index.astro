---
import Base from "../layouts/Base.astro";
import RecordGrid from "../components/RecordGrid.astro";
import { getCollection } from "../lib/view-model.ts";
import { plural } from "../lib/format.ts";

const items = getCollection();
---

<Base title="Collection" nav="collection">
	<span slot="actions" class="t-small muted">{plural(items.length, "record")}</span>

	{
		items.length === 0 ? (
			<p class="empty">
				Records you sync will appear here. Run <code>npm run sync</code> then <code>npm run images</code>, or append{" "}
				<code>-- --mock</code> to try it with fixture data first.
			</p>
		) : (
			<RecordGrid
				records={items.map((item) => ({
					key: item.instanceId,
					href: `/r/${item.instanceId}/`,
					cover: item.cover,
					title: item.title,
					artists: item.artists,
					year: item.year,
				}))}
			/>
		)
	}
</Base>
