---
// Aperture BarList: ranked breakdown. Shows at most eight rows; the rest are grouped as "Other".
import { plural } from "../../lib/format.ts";

export interface BarRow {
  label: string;
  value: number;
  display?: string;
}
interface Props {
  rows: BarRow[];
  /** Noun for the grouped remainder, e.g. "label" → "75 more labels". */
  noun: string;
  limit?: number;
}
const { rows, noun, limit = 8 } = Astro.props;

const sorted = [...rows].sort((a, b) => b.value - a.value);
let shown = sorted.slice(0, limit);
const rest = sorted.slice(limit);
const restTotal = rest.reduce((sum, r) => sum + r.value, 0);
const topValue = shown[0]?.value ?? 1;

// Keep "Other" as a bar only when it fits the scale of the ranked rows;
// a long tail that would dwarf them is summarised in a caption instead.
let caption: string | undefined;
if (rest.length > 0) {
  if (restTotal <= topValue) {
    shown = [...shown, { label: "Other", value: restTotal }];
  } else {
    caption = `Other: ${plural(rest.length, noun)}, ${restTotal.toLocaleString("en-US")} in total`;
  }
}
const max = Math.max(1, ...shown.map((r) => r.value));
---

<div class="ap-barlist">
  {
    shown.map((r) => {
      const display = r.display ?? r.value.toLocaleString("en-US");
      return (
        <div class="ap-barlist__row">
          <span class="bar-label" title={r.label}>{r.label}</span>
          <div class="ap-barlist__track" role="img" aria-label={`${r.label} ${display}`}>
            <div class="ap-barlist__fill" style={`width:${Math.max(1, (r.value / max) * 100)}%`} />
          </div>
          <span class="ap-barlist__value">{display}</span>
        </div>
      );
    })
  }
</div>
{caption && <p class="bar-caption t-caption">{caption}</p>}

<style>
  .bar-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bar-caption {
    margin: var(--space-2) 0 0;
    color: var(--text-muted);
  }
</style>
