---
import type { CoverDerivative } from "../lib/view-model.ts";

interface Props {
  cover?: CoverDerivative;
  size: "hero" | "grid" | "thumb";
  alt: string;
  eager?: boolean;
}
const { cover, size, alt, eager = false } = Astro.props;
const backdrop = cover?.palette[0];
---

{
  cover ? (
    <div class="cover" style={`background-image:url(${cover.placeholder});${backdrop ? `background-color:${backdrop};` : ""}`}>
      <picture>
        <source srcset={cover[size].avif} type="image/avif" />
        <source srcset={cover[size].webp} type="image/webp" />
        <img src={cover[size].jpg} alt={alt} loading={eager ? "eager" : "lazy"} decoding="async" />
      </picture>
    </div>
  ) : (
    <div class="cover cover--empty" aria-hidden="true" />
  )
}

<style>
	.cover {
		aspect-ratio: 1 / 1;
		background-color: var(--surface-active);
		background-size: cover;
		background-position: center;
		overflow: hidden;
		border-radius: var(--radius-md);
		position: relative;
	}

	/* Hairline so dark covers keep an edge on the near-black ground. */
	.cover::after {
		content: "";
		position: absolute;
		inset: 0;
		border: 1px solid var(--border);
		border-radius: inherit;
		pointer-events: none;
	}

	.cover picture,
	.cover img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
</style>
